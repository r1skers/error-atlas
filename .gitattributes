* text=auto eol=lf

*.md text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Preserve one-shot CSV evidence byte-for-byte; csv.DictWriter emits CRLF records.
topics/softmax/experiments/results/wide_range_online_risk_certificate_calibration_v1/calibration/*.csv -text -diff

*.png binary
*.jpg binary
*.jpeg binary

# Preserve online run bundles byte-for-byte; every manifest records the SHA-256 of the
# file as written on the measuring machine, and the runners and verifiers re-check it.
# Python text writes emit CRLF on Windows, so eol=lf normalisation would invalidate
# every recorded hash on checkout.
topics/softmax/experiments/online/runs/** -text -diff
